/*
 * 编译器全流程示例：覆盖算术、赋值、分支、循环、数组、函数、递归与短路求值。
 * Compiler-pipeline example covering arithmetic, assignment, branches, loops,
 * arrays, functions, recursion, and short-circuit evaluation.
 */

int ticks = 0;

/** 记录右操作数被求值。 / Record evaluation of the right operand. */
int mark() {
  ticks = ticks + 1;
  return 1;
}

/** 递归计算小规模 Fibonacci。 / Recursively compute a bounded Fibonacci value. */
int fib(int n) {
  if (n <= 1) {
    return n;
  }
  return fib(n - 1) + fib(n - 2);
}

/** 对数组前 length 项求和。 / Sum the first length array elements. */
int sum(int values[], int length) {
  int i = 0;
  int total = 0;
  while (i < length) {
    total = total + values[i];
    i = i + 1;
  }
  return total;
}

/** 读取输入并打印结果与短路计数。 / Read input and print result plus short-circuit count. */
int main() {
  int values[8];
  int n = getint();
  int i = 0;

  if (n < 0) {
    n = 0;
  }
  if (n > 8) {
    n = 8;
  }

  /* n == 0 时也让 values[0] 有定义。 / Keep values[0] defined for n == 0. */
  values[0] = 0;
  while (i < n) {
    values[i] = i * i + i + 1;
    i = i + 1;
  }

  /* n <= 2 时 mark 不得执行，这使短路语义可观察。 / mark must be skipped. */
  if (n > 2 && mark()) {
    values[0] = values[0] + fib(n);
  } else {
    values[0] = values[0] + 7;
  }

  putint(sum(values, n));
  putch(10);
  putint(ticks);
  putch(10);
  return 0;
}
